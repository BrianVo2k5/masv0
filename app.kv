<MainRoot>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
        StencilPush
        Ellipse:
            pos: self.center_x - app.reveal_radius, self.center_y - app.reveal_radius
            size: app.reveal_radius * 2, app.reveal_radius * 2
        StencilUse
        Color:
            rgba: 1, 1, 1, 1
    canvas.after:
        StencilUnUse
        Ellipse:
            pos: self.center_x - app.reveal_radius, self.center_y - app.reveal_radius
            size: app.reveal_radius * 2, app.reveal_radius * 2
        StencilPop

    MDScreenManager:
        id: screen_manager
        SetupScreen:
            name: "setup"
        ChatScreen:
            name: "chat"
        SettingsScreen:
            name: "settings"

<SetupScreen@MDScreen>:
    md_bg_color: 1, 1, 1, 1
    MDBoxLayout:
        orientation: "vertical"
        padding: "40dp"
        spacing: "30dp"
        pos_hint: {"center_x": .5, "center_y": .5}
        size_hint_y: None
        height: self.minimum_height

        FitImage:
            source: "app_textures/chat.jpg"
            size_hint: None, None
            size: "200dp", "200dp"
            pos_hint: {"center_x": .5}

        MDLabel:
            text: app.bot_name
            font_style: "H4"
            halign: "center"
            theme_text_color: "Primary"

        MDLabel:
            text: app.bot_description
            font_style: "Body1"
            halign: "center"
            theme_text_color: "Secondary"
            italic: True

        RelativeLayout:
            size_hint: .8, None
            height: name_input.height
            pos_hint: {"center_x": .5}

            MDTextField:
                id: name_input
                font_name: "JetBrains Mono"
                hint_text: "" # Real hint is hidden
                mode: "round"
                on_text_validate: app.switch_to_chat(self.text)

            MDLabel:
                text: "What's your name?"
                font_name: "JetBrains Mono"
                theme_text_color: "Hint"
                pos_hint: {"center_y": .5}
                x: "20dp" # Offset to look like it's inside the rounded field
                opacity: 1 if not name_input.text else 0

        MDFillRoundFlatButton:
            text: "Start summarizing!"
            # This makes it "Flat" by removing the shadow
            elevation: 0
            
            # Customizing the "Tonal" colors
            md_bg_color: 0.1, 0.1, 0.1, 1  # Very dark grey (almost black)
            text_color: 1, 1, 1, 1         # White text
            
            pos_hint: {"center_x": .5}
            on_release: app.switch_to_chat(name_input.text)

<ChatScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: 1, 1, 1, 1 

        MDTopAppBar:
            title: "What would you like to summarize today, " + app.user_name + "?"
            elevation: 0
            md_bg_color: 1, 1, 1, 1
            specific_text_color: 0, 0, 0, 1
            right_action_items: [["cog", lambda x: app.switch_to_settings()]]

        MDLabel:
            text: ("BART XSum" if app.active_model == "bart-xsum" else "CNN / Daily Mail") + "  ·  " + str(app.active_max_new_tokens) + " tok max"
            font_name: "JetBrains Mono"
            font_style: "Caption"
            theme_text_color: "Hint"
            halign: "right"
            size_hint_y: None
            height: "18dp"
            padding_x: "20dp"

        MDScrollView:
            id: scroll_view
            MDList:
                id: chat_list
                adaptive_height: True
                padding: "20dp"
                spacing: "15dp"

        MDBoxLayout:
            id: results_layout
            size_hint_y: None
            height: "90dp"
            padding: "10dp"
            spacing: "10dp"
            md_bg_color: 1, 1, 1, 1

            MDIconButton:
                icon: "file-upload"
                pos_hint: {"center_y": .5}
                on_release: app.open_file()

            RelativeLayout:
                MDTextField:
                    id: text_input
                    font_name: "JetBrains Mono"
                    hint_text: ""
                    mode: "round"
                    pos_hint: {"center_y": .5}
                    on_text_validate: root.send_message(self, chat_list, scroll_view)

                MDLabel:
                    text: "Feed me the content and I'll summarize it!"
                    font_name: "JetBrains Mono"
                    theme_text_color: "Hint"
                    pos_hint: {"center_y": .5}
                    x: "20dp"
                    opacity: 1 if not text_input.text else 0

            MDIconButton:
                pos_hint: {"center_y": .5}
                icon: "send"
                on_release: root.send_message(text_input, chat_list, scroll_view)

<SettingsScreen@MDScreen>:
    md_bg_color: 1, 1, 1, 1
    MDBoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            title: "Settings"
            elevation: 0
            md_bg_color: 1, 1, 1, 1
            specific_text_color: 0, 0, 0, 1
            left_action_items: [["arrow-left", lambda x: app.go_back_to_chat()]]

        MDBoxLayout:
            orientation: 'vertical'
            padding: "40dp"
            spacing: "20dp"

            MDLabel:
                text: "Summarization Model"
                font_name: "JetBrains Mono"
                font_style: "H5"
                theme_text_color: "Primary"
                size_hint_y: None
                height: self.texture_size[1]

            MDLabel:
                text: "Both models are pre-loaded — switching is instant."
                font_name: "JetBrains Mono"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                orientation: 'vertical'
                spacing: "10dp"
                size_hint_y: None
                adaptive_height: True

                MDFillRoundFlatButton:
                    text: "BART XSum"
                    font_name: "JetBrains Mono"
                    size_hint_x: 1
                    md_bg_color: (0.1, 0.1, 0.1, 1) if app.active_model == "bart-xsum" else (0.94, 0.94, 0.94, 1)
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.active_model == "bart-xsum" else (0.3, 0.3, 0.3, 1)
                    on_release: app.switch_model("bart-xsum")

                MDFillRoundFlatButton:
                    text: "CNN / Daily Mail"
                    font_name: "JetBrains Mono"
                    size_hint_x: 1
                    md_bg_color: (0.1, 0.1, 0.1, 1) if app.active_model == "cnn-dm" else (0.94, 0.94, 0.94, 1)
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.active_model == "cnn-dm" else (0.3, 0.3, 0.3, 1)
                    on_release: app.switch_model("cnn-dm")

            MDBoxLayout:
                orientation: 'vertical'
                spacing: "6dp"
                size_hint_y: None
                height: "78dp"

                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "22dp"

                    MDLabel:
                        text: "Max output length"
                        font_name: "JetBrains Mono"
                        theme_text_color: "Secondary"
                        size_hint_x: 0.7

                    MDLabel:
                        id: token_label
                        text: str(int(output_slider.value)) + " tokens"
                        font_name: "JetBrains Mono"
                        theme_text_color: "Primary"
                        halign: "right"
                        size_hint_x: 0.3

                Slider:
                    id: output_slider
                    size_hint_y: None
                    height: "46dp"
                    min: app.output_tokens_min
                    max: app.output_tokens_max
                    value: app.output_tokens
                    step: 1
                    on_value: app.on_output_tokens_change(self.value)

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: "52dp"
                spacing: "8dp"

                MDLabel:
                    text: "Max attempts"
                    font_name: "JetBrains Mono"
                    theme_text_color: "Secondary"
                    size_hint_x: 0.6
                    pos_hint: {"center_y": 0.5}

                MDIconButton:
                    icon: "minus"
                    pos_hint: {"center_y": 0.5}
                    disabled: app.max_attempts <= 1
                    on_release: app.adjust_max_attempts(-1)

                MDLabel:
                    text: str(app.max_attempts)
                    font_name: "JetBrains Mono"
                    theme_text_color: "Primary"
                    halign: "center"
                    size_hint_x: None
                    width: "24dp"
                    pos_hint: {"center_y": 0.5}

                MDIconButton:
                    icon: "plus"
                    pos_hint: {"center_y": 0.5}
                    disabled: app.max_attempts >=20
                    on_release: app.adjust_max_attempts(1)